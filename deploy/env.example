# /etc/billing-guard/env (root:root, mode 600). Never commit real values.

# dry-run (default) only reports. enforce also shuts servers down.
GUARD_MODE=dry-run

# Hetzner Cloud API token for the project to guard, with Read & Write permission
# (write is needed only to shut servers down). One project per guard install.
HCLOUD_TOKEN=
# Alert when the estimated monthly bill (list prices, excl. VAT) is above this.
MONTHLY_BUDGET_EUR=

# Optional: a Robot webservice user, to watch dedicated-server traffic (alerts only).
ROBOT_USER=
ROBOT_PASSWORD=

# Where alerts go. Use a long random topic name: anyone who knows it can read your alerts.
NTFY_URL=https://ntfy.sh/
# Optional access token, for a protected topic or a self-hosted ntfy.
NTFY_TOKEN=

# Optional but recommended: a healthchecks.io check (period 5 min, grace 15 min).
HEALTHCHECK_URL=

# Thresholds (defaults shown).
TRAFFIC_WARN_PERCENT=50
TRAFFIC_KILL_PERCENT=90
ROBOT_HOURLY_OUT_GB=200
ROBOT_DAILY_OUT_GB=2000
REMIND_HOURS=6
