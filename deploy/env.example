# /etc/billing-guard/env (root:root, mode 600). Never commit real values.
# systemd EnvironmentFile format: one NAME=value per line, no quotes, no comments after a value.

# dry-run (default) only reports. enforce also shuts servers down, and needs HEALTHCHECK_URL.
GUARD_MODE=dry-run

# Hetzner Cloud API token for the project to guard, Read & Write (write is needed only to shut servers
# down). One project per guard install.
HCLOUD_TOKEN=
# Alert when the estimated monthly run-rate (list prices, excl. VAT) is above this.
MONTHLY_BUDGET_EUR=

# Optional: a Robot webservice user, to watch dedicated-server traffic (alerts only).
ROBOT_USER=
ROBOT_PASSWORD=

# Where alerts go: https://ntfy.sh/<topic>. Prefer a protected topic with NTFY_TOKEN: anyone who
# knows an open topic's name can read your alerts or flood it.
NTFY_URL=
NTFY_TOKEN=

# A healthchecks.io check (period 5 min, grace 15 min). Required in enforce mode.
HEALTHCHECK_URL=

# Thresholds (defaults shown). KILL_OVERRIDES raises the cap for single servers: <server id>=<percent>,...
TRAFFIC_WARN_PERCENT=50
TRAFFIC_KILL_PERCENT=90
KILL_OVERRIDES=
ROBOT_HOURLY_OUT_GB=200
ROBOT_DAILY_OUT_GB=2000
REMIND_HOURS=6
